# Backend base URL. On a real phone "localhost" is the phone itself, so use this PC's LAN IP.
# Phone and PC must be on the same Wi-Fi. Restart `npx expo start` after changing this.
EXPO_PUBLIC_API_URL=http://192.168.1.11:5000/api
# EXPO_PUBLIC_API_URL=https://api.crm.rebootai.in/api
EXPO_PUBLIC_WEB_URL=https://crm.rebootai.in