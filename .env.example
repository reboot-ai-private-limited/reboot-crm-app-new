# Copy this file to .env (not committed) and fill it in. Restart `npx expo start` after changing it.
# The values are built into the app, so an APK uses whatever is here when it is built.

# Backend base URL. On a real phone "localhost" is the phone itself: for local dev use this PC's LAN IP
# (phone and PC on the same Wi-Fi). For a release APK use the production API.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
# EXPO_PUBLIC_API_URL=https://api.crm.rebootai.in/api

# Public web URL of the CRM frontend (no trailing slash). Needed to preview and share proposal links.
EXPO_PUBLIC_WEB_URL=https://crm.rebootai.in
